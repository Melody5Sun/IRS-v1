{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git branch*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(pip install*)",
      "Read",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PreCommit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-hook.sh"
          }
        ]
      }
    ]
  }
}

#!/bin/bash
# git commit-msg 钩子（需 git config core.hooksPath .claude/hooks 激活）
# 检查：1) 禁止 Co-Authored-By 行（无论谁提交）  2) 敏感文件未被提交

COMMIT_MSG_FILE="$1"

if [ -n "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      Co-Authored-By:*)
        echo "错误: 提交信息不能包含 'Co-Authored-By:' 尾注行（学术项目要求：以提交者本人身份提交，不添加共同作者标注）"
        exit 1
        ;;
    esac
  done < "$COMMIT_MSG_FILE"
fi

STAGED=$(git diff --cached --name-only)
for f in $STAGED; do
  case "$f" in
    .env|.env.local|*.key|*credentials*)
      echo "错误: 检测到敏感文件被提交: $f"
      echo "请从暂存区移除: git restore --staged \"$f\""
      exit 1
      ;;
  esac
done

exit 0
